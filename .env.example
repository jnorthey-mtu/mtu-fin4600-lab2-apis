# Copy this file to ".env" and fill in any keys you have. NEVER commit .env to GitHub.
# All keys are optional — every mission works without them.

# CoinGecko free Demo key (100 calls/min, avoids the shared classroom IP limit)
# https://www.coingecko.com/en/api/pricing  → "Create Demo account"
COINGECKO_DEMO_KEY=

# Alpha Vantage free key (25 requests/day). "demo" only works for IBM.
# https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=demo

# FRED free key — https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
